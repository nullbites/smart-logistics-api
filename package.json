{
  "name": "smart-logistics-api",
  "version": "0.1.1",
  "description": "Smart Logistics API: route optimization and multi-stop pathfinding service over a Fastify + Prisma stack.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "smart-logistics": "bin/smart-logistics.js"
  },
  "files": [
    "dist",
    "prisma",
    "scripts",
    "docker-compose.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli/index.ts serve --verbose",
    "start": "node dist/cli/index.js serve",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "typecheck": "tsc --noEmit",
    "typecheck:seed": "tsc -p tsconfig.seed.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "prisma db seed",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "setup": "bash scripts/bootstrap.sh"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "deepmerge-ts": ">=8.0.0",
    "mysql2": ">3.23.0"
  }
}
